---
// Open data: the three downloads, what each holds, the licence and how to credit. Built from content at build time;
// the files are plain static JSON (src/pages/data/*.json.ts, src/lib/opendata.ts).
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import LevelTable from '../../components/ui/LevelTable.astro';
import { findsFile, connectionsFile, collectiblesFile, LICENCE } from '../../lib/opendata';
import { formatDate } from '../../lib/finds';

const files = [
  { href: '/data/finds.json', name: 'Finds', file: findsFile(), holds: 'Published finds with their category, verification, spoiler and chapter flags, region, clip, sources and first finder. Drafts and rumours are left out.', credit: 'Each record keeps its sources, its clip creator and its first finder. A mature find lists its sources, and links its clip and first finder, on its own page only.' },
  { href: '/data/connections.json', name: 'GTAverse connections', file: connectionsFile(), holds: 'Every link between GTA VI and the wider Rockstar universe, with its type, confidence, games and sources.', credit: 'Each record keeps its sources.' },
  { href: '/data/collectibles.json', name: 'Collectible locations', file: collectiblesFile(), holds: 'Collectible pins transcribed from the Game Checklists maps, in pixels of the official map image (the image is not included).', credit: 'Credit Game Checklists with every use: each record names them and links their map.' },
];
---
<Base title="Open data" description="Download The Vice Files finds, GTAverse connections and collectible locations as JSON, under CC BY-NC 4.0.">
  <header class="head">
    <h1 class="head__title">Open data</h1>
    <p class="head__lede">The finds, the GTAverse connections and the collectible locations behind this site, as JSON files you can use for non-commercial projects. Rebuilt with every update to the site.</p>
  </header>

  <ul class="files" role="list">
    {files.map((f) => (
      <li class="file">
        <div class="file__text">
          <h2 class="file__name">{f.name}</h2>
          <p class="file__meta"><span class="mono">{f.href}</span> · {f.file.count} records · content of {formatDate(f.file.content_date) ?? f.file.content_date}</p>
          <p class="file__holds">{f.holds}</p>
          <p class="file__credit">{f.credit}</p>
        </div>
        <Button href={f.href} variant="secondary" size="l" icon="arrow-down" download>Download</Button>
      </li>
    ))}
  </ul>

  <section class="terms" aria-labelledby="terms-title">
    <h2 id="terms-title" class="terms__title">Licence and credit</h2>
    <LevelTable
      head={['Term', 'What it means']}
      rows={[
        { label: 'Licence', cells: [`${LICENCE.licence}: share and adapt for non-commercial use, with credit.`] },
        { label: 'Credit', cells: [`"${LICENCE.how_to_cite}"`] },
        { label: 'Keep credits', cells: ['Keep each record\'s sources, finders and clip creators, and credit Game Checklists for collectible locations.'] },
        { label: 'Not licensed', cells: [LICENCE.not_licensed] },
      ]}
      footnote="Every file starts with these terms in its header, beside the content date it was built from."
    />
    <p class="terms__more">Read the full licence at <a href={LICENCE.licence_url} rel="noopener" target="_blank">creativecommons.org</a>. Corrections and credit requests: takedown@thevicefiles.com.</p>
  </section>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: var(--space-4); max-width: 820px; }
  .head__title {
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    font-weight: 900;
    font-size: var(--text-display-l);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }
  .head__lede { max-width: var(--measure-short); color: var(--text-2); }
  .files { margin-top: var(--space-12); border-top: var(--border-w) solid var(--border-1); }
  .file { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); padding-block: var(--space-6); border-bottom: var(--border-w) solid var(--border-1); }
  .file__text { display: flex; flex-direction: column; gap: var(--space-2); max-width: 760px; }
  .file__name { font-size: var(--text-h2); font-weight: 700; }
  .file__meta { color: var(--text-3); font-size: var(--text-body-s); }
  .file__holds { color: var(--text-1); }
  .file__credit { color: var(--text-2); font-size: var(--text-body-s); }
  .terms { display: flex; flex-direction: column; gap: var(--space-6); margin-top: var(--space-16); padding-bottom: var(--space-section); max-width: 900px; }
  .terms__title { font-size: var(--text-h2); font-weight: 700; }
  .terms__more { color: var(--text-2); font-size: var(--text-body-s); }
  .terms__more a { color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 767px) {
    .files { margin-top: var(--space-8); }
    .file { flex-direction: column; align-items: stretch; gap: var(--space-4); }
  }
</style>
