---
// A find. Desktop is the Disney+ web title page as drawn: the find's still fills the page behind everything under a
// left and bottom scrim, the title, badges, meta and synopsis sit in a left column, then a white pill and a circle,
// then underline tabs over a 16:9 grid. Phone is the Disney+ iOS page at its own size: art on the top half with the
// Google TV Trailer chip, centred caps title and badges, Google TV stacked pills, Disney icon actions, caps tabs.
// Tabs in order Details, Clips, Related, Nearby. Clips tab: the clip, then the other videos as the Xbox shot grid. Details tab: Disney label and value pairs,
// Mindtrip tips ("How to find it") and the Mindtrip author card, retitled for the finder or the clip's creator.
// Spoiler and mature finds never show art outside their reveal. A mature find keeps its title in the heading, the tab
// and the share title; its meta, social and structured-data descriptions never carry its summary (pageDescription,
// LR83), and other finds' cards name it "Mature find: <type>" (publicTitle).
import Base from '../../layouts/Base.astro';
import Clip from '../../components/Clip.astro';
import Verification from '../../components/Verification.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Icon from '../../components/ui/Icon.astro';
import Tabs from '../../components/ui/Tabs.astro';
import Spoiler from '../../components/Spoiler.astro';
import GameChips from '../../components/games/GameChips.astro';
import { gamesOfFind } from '../../lib/games';
import { splitSpoiler } from '../../lib/spoiler';
import { finds, type Find } from '../../lib/content';
import { findStill, findClipLabels, showcaseable, categoryLabel, regionLabel, publicTitle, pageDescription } from '../../lib/media';
import { ytThumb } from '../../lib/clip';
import { credit, creditLine, moreClips, relatedFinds, relatedLore, regionNames, tips, cardImage, formatDate, platformName, verificationLabel, verificationNote } from '../../lib/finds';
import { nearbyFinds, hasRegionHub, hasCategoryHub } from '../../lib/hubs';
import { regionById, categoryById } from '../../lib/content';
import { correctionLink, submitFindLink } from '../../lib/issues';
import { findPage } from '../../lib/seo';
import { site } from '../../lib/site';

export function getStaticPaths() {
  return finds.map((f) => ({ params: { slug: f.slug }, props: { find: f } }));
}
const { find } = Astro.props as { find: Find };
const gated = find.spoiler || find.mature;
const still = showcaseable(find) ? findStill(find) : null;
// A spoiler find gated to a chapter keeps its art out of the page until the visitor's chapter has reached it.
const lateStill = !still && find.spoiler && !find.mature && find.chapter_gate ? findStill(find) : null;
const synopsis = splitSpoiler(find.summary);
const who = credit(find);
const line = creditLine(find);
const updated = formatDate(find.updated_at);
const others = moreClips(find);
const lore = relatedLore(find);
const near = nearbyFinds(find, 10);
const related = relatedFinds(find, 10 - Math.min(lore.length, 4), near.map((h) => h.find.slug));
const howTo = tips(find.location_description);
const mapHref = find.pin ? `/map?find=${find.slug}` : null;
const hasClips = Boolean(find.clip) || others.length > 0;
// Details first: most visitors come to read where the find is and how to get it, then to watch the clip; related
// and nearby finds come last (decision P8). The first tab is the one open when the page loads.
const tabs = [
  { id: 'details', label: 'Details' },
  ...(hasClips ? [{ id: 'clips', label: 'Clips' }] : []),
  { id: 'related', label: 'Related' },
  ...(near.length > 0 ? [{ id: 'nearby', label: 'Nearby' }] : []),
];
// "Play clip", or "View photo" and "Read the post" for X and Reddit photo and text posts (src/lib/clip.ts clipLabels).
const labels = findClipLabels(find);
const sub = mapHref
  ? { href: mapHref, label: 'Open on the map', image: still?.thumb }
  : find.clip
    ? { href: '?tab=clips#tabs', openTab: 'clips', label: gated ? labels.revealBar : labels.bar, image: still?.thumb }
    : undefined;
const loreConfidence: Record<string, string> = { canon: 'Canon', strong: 'Strong', speculative: 'Speculative', debunked: 'Debunked' };
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const categoryName = categoryById(find.category)?.label ?? categoryLabel(find);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Finds', href: '/finds' },
  ...(hasCategoryHub(find.category) ? [{ name: categoryName, href: `/categories/${find.category}` }] : []),
  { name: find.title, href: `/finds/${find.slug}` },
];
const nearLabel = (h: (typeof near)[number]) => h.reason === 'distance' ? `${regionLabel(h.find)} · On the map nearby` : `Also in ${regionById(h.region ?? '')?.name ?? regionLabel(h.find)}`;
---
<Base title={find.title} description={pageDescription(find)} layout="bare" sub={sub} ogType="article" jsonLd={findPage(find, who)} breadcrumbs={crumbs}>
  <article class="find" data-find>
    <div class:list={['find__art', { 'find__art--glow': !still }]} aria-hidden="true">
      {still && <img src={still.src} srcset={still.srcset} sizes="100vw" alt="" width="1280" height="720" fetchpriority="high" decoding="async" data-nofade />}
      {lateStill && <img data-chapter-src={lateStill.src} data-chapter-srcset={lateStill.srcset} data-chapter-gate={find.chapter_gate} sizes="100vw" alt="" width="1280" height="720" decoding="async" hidden />}
      <div class="find__scrim"></div>
    </div>

    <div class="container find__inner">
      <header class="find__hero">
        {find.clip && (
          <a class:list={['find__trailer', { 'find__trailer--solid': !still }]} href="#tabs" data-open-tab="clips">
            <Icon name={labels.icon} size={20} />
            <span>{gated ? labels.spoiler : labels.action}</span>
          </a>
        )}
        <h1 class="find__title">{find.title}</h1>
        <div class="find__badges">
          <Badge variant="meta">{categoryLabel(find)}</Badge>
          <Badge variant="meta">{regionLabel(find)}</Badge>
          <Verification level={find.verification} />
          {find.spoiler && <Badge variant="outline">Spoiler</Badge>}
          {find.mature && <Badge variant="outline">Mature</Badge>}
        </div>
        <p class="find__meta">
          {line && <span>{line}</span>}
          {line && updated && <span aria-hidden="true"> · </span>}
          {updated && <span>Updated <time datetime={find.updated_at}>{updated}</time></span>}
        </p>
        <p class="find__synopsis">{synopsis.before}</p>
        {synopsis.spoiler && <Spoiler chapter={synopsis.spoiler.chapter}><p>{synopsis.spoiler.text}</p></Spoiler>}
        <GameChips games={gamesOfFind(find)} class="find__also" />

        <!-- Desktop: Disney white pill and circle -->
        <div class="find__actions find__actions--web">
          {find.clip ? (
            <Button href="#tabs" variant="inverse" size="l" icon={labels.icon} data-open-tab="clips">{gated ? labels.reveal : labels.action}</Button>
          ) : (
            <Button href="#tabs" variant="inverse" size="l" icon="pin" data-open-tab="details">How to find it</Button>
          )}
          {mapHref ? (
            <Button href={mapHref} variant="glass" size="l" icon="map" iconOnly label="Open on the map" />
          ) : (
            <button type="button" class="btn btn--glass btn--l btn--icon copy" aria-label="Share this find" title="Share this find" data-share>
              <span class="copy__icons" aria-hidden="true"><Icon name="share" size={24} class="copy__from" /><Icon name="check" size={24} class="copy__to" /></span>
            </button>
          )}
        </div>

        <!-- Phone: Google TV stacked pills -->
        <div class="find__actions find__actions--phone">
          {find.clip ? (
            <a class="pill pill--primary" href="#tabs" data-open-tab="clips">
              <span class="pill__icon" aria-hidden="true"><Icon name={labels.icon} size={20} /></span>
              <span class="pill__text">
                <span class="pill__title">{gated ? labels.reveal : labels.action}</span>
                {find.clip?.creator && <span class="pill__sub">Clip by {find.clip.creator}</span>}
              </span>
            </a>
          ) : (
            <a class="pill pill--primary" href="#tabs" data-open-tab="details">
              <span class="pill__icon" aria-hidden="true"><Icon name="pin" size={20} /></span>
              <span class="pill__text">
                <span class="pill__title">How to find it</span>
                <span class="pill__sub">{regionLabel(find)}</span>
              </span>
            </a>
          )}
          {mapHref ? (
            <a class="pill pill--secondary" href={mapHref}><Icon name="map" size={24} /><span>Open on the map</span></a>
          ) : (
            <a class="pill pill--secondary" href="#tabs" data-open-tab={find.clip ? 'details' : 'related'}>
              <Icon name={find.clip ? 'pin' : 'finds'} size={24} /><span>{find.clip ? 'How to find it' : 'Related finds'}</span>
            </a>
          )}
        </div>

        <!-- Phone: Disney icon actions -->
        <ul class="find__icons">
          <li><a href="#tabs" data-open-tab="related"><Icon name="finds" size={24} /><span>Related</span></a></li>
          <li><a href="#tabs" data-open-tab="details"><Icon name="link" size={24} /><span>Sources</span></a></li>
          <li>
            <button type="button" class="copy" data-share>
              <span class="copy__icons" aria-hidden="true"><Icon name="share" size={24} class="copy__from" /><Icon name="check" size={24} class="copy__to" /></span>
              <span class="copy__label" aria-hidden="true"><span class="copy__l copy__l--from">Share</span><span class="copy__l copy__l--to">Copied</span></span>
              <span class="sr-only">Share</span>
            </button>
          </li>
        </ul>
        <p class="sr-only" aria-live="polite" data-share-status></p>
      </header>

      <div class="find__tabs" id="tabs">
        <Tabs id="find" tabs={tabs} label="About this find">
          <div slot="related">
            <h2 class="sr-only">Related finds and lore</h2>
            <ul class="grid">
              {lore.slice(0, 4).map((c) => (
                <li><Card href={`/gtaverse/${c.slug}`} kicker="GTAverse" title={c.title} meta={`${loreConfidence[c.confidence] ?? c.confidence} · ${c.games.slice(-1)[0] ?? ''}`} /></li>
              ))}
              {related.map((f) => {
                const img = cardImage(f);
                return (
                  <li><Card href={`/finds/${f.slug}`} image={img?.src} srcset={img?.srcset} sizes="(max-width: 767px) 50vw, 20vw" kicker={categoryLabel(f)} title={publicTitle(f)} meta={`${regionLabel(f)} · ${verificationLabel[f.verification] ?? f.verification}${f.spoiler ? ' · Spoiler' : ''}`} /></li>
                );
              })}
            </ul>
          </div>

          {near.length > 0 && (
            <div slot="nearby">
              <h2 class="sr-only">Nearby finds</h2>
              <ul class="grid">
                {near.map((h) => {
                  const img = cardImage(h.find);
                  return (
                    <li><Card href={`/finds/${h.find.slug}`} image={img?.src} srcset={img?.srcset} sizes="(max-width: 767px) 50vw, 20vw" kicker={categoryLabel(h.find)} title={publicTitle(h.find)} meta={`${nearLabel(h)}${h.find.spoiler ? ' · Spoiler' : ''}`} /></li>
                  );
                })}
              </ul>
            </div>
          )}

          {hasClips && (
            <div slot="clips" class="clips">
              <h2 class="sr-only">Clips</h2>
              {find.clip && <Clip clip={find.clip} title={find.title} spoiler={find.spoiler} mature={find.mature} chapterGate={find.chapter_gate} class="clips__main" />}
              {others.length > 0 && (
                <section class="shots" aria-labelledby="shots-title">
                  <h2 id="shots-title" class="find__h2">More videos of this find</h2>
                  <ul class="shots__grid">
                    {others.map((o) => (
                      <li>
                        <a class="shot" href={o.url} rel="noopener" target="_blank">
                          <span class:list={['shot__media', { 'shot__media--glow': gated }]}>
                            {!gated && <img src={ytThumb(o.id!, 'mq')} alt="" width="320" height="180" loading="lazy" decoding="async" />}
                            {gated && <span class="mono-caps">Spoiler</span>}
                          </span>
                          <span class="shot__label">{o.creator} <Icon name="arrow-up-right" size={14} /></span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          )}

          <div slot="details" class="details">
            <h2 class="sr-only">Details</h2>
            <div class="details__main">
              {howTo.length > 0 && (
                <section class="tips" aria-labelledby="tips-title">
                  <h2 id="tips-title" class="tips__title">How to find it <span title="From the creators' clips and write ups"><Icon name="info" size={16} /></span></h2>
                  <ul class="tips__list">{howTo.map((t) => <li>{t}</li>)}</ul>
                </section>
              )}
              <dl class="facts">
                <div><dt>Category</dt><dd>{hasCategoryHub(find.category) ? <a class="link" href={`/categories/${find.category}`}>{categoryLabel(find)}</a> : categoryLabel(find)}</dd></div>
                <div><dt>Where</dt><dd>{find.region_ids.length > 0 ? <span>{find.region_ids.map((id, i) => <>{i > 0 && ', '}{hasRegionHub(id) ? <a class="link" href={`/regions/${id}`}>{regionById(id)?.name ?? id}</a> : (regionById(id)?.name ?? id)}</>)}</span> : regionNames(find).join(', ')}{find.area && <span class="facts__sub">{find.area}</span>}</dd></div>
                <div><dt>Verification</dt><dd><Verification level={find.verification} /><span class="facts__sub">{verificationNote[find.verification] ?? ''}</span></dd></div>
                {find.chapter_gate && <div><dt>Unlocks after</dt><dd>{find.chapter_gate}</dd></div>}
                {(find.crossover_games?.length ?? 0) > 0 && <div><dt>Crossover</dt><dd>{find.crossover_games!.join(', ')}</dd></div>}
                {gated && <div><dt>Content</dt><dd>{[find.spoiler && 'Spoiler', find.mature && 'Mature'].filter(Boolean).join(', ')}</dd></div>}
                {updated && <div><dt>Updated</dt><dd>{updated}</dd></div>}
              </dl>
            </div>

            <aside class="details__side">
              {who && (
                <section class="about" aria-labelledby="about-title">
                  <h2 id="about-title" class="about__title">{who.kind === 'finder' ? 'About the finder' : 'About the clip'}</h2>
                  <div class="about__who">
                    <span class="about__avatar" aria-hidden="true">{who.name.replace(/^(?:@|u\/)/, '').charAt(0).toUpperCase()}</span>
                    <span class="about__name">
                      <span>{who.name}</span>
                      <span class="about__role">{who.kind === 'finder' ? `First found it, on ${who.platform}` : `Made the clip, on ${who.platform}`}</span>
                    </span>
                  </div>
                  {who.url && (
                    <div class="about__actions">
                      <Button href={who.url} variant="outline" size="m" iconEnd="arrow-up-right" target="_blank" rel="noopener">{who.kind === 'finder' ? 'View post' : `${labels.on} ${who.platform}`}</Button>
                    </div>
                  )}
                </section>
              )}
              <section class="sources" aria-labelledby="sources-title">
                <h2 id="sources-title" class="find__h2">Sources</h2>
                <ul class="sources__list">
                  {find.sources.map((s) => (
                    <li>
                      <a class="source" href={s.url} rel="noopener" target="_blank">
                        <span class="source__thumb" aria-hidden="true"><Icon name="link" size={20} /></span>
                        <span class="source__text">
                          <span class="source__kind"><Icon name="link" size={12} /> {platformName(s.type)}</span>
                          <span class="source__title">{s.creator ?? host(s.url)}</span>
                          <span class="source__url">{host(s.url)}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            </aside>
          </div>
        </Tabs>
      </div>

      <aside class="fix" aria-labelledby="fix-title">
        <h2 id="fix-title" class="fix__title">Something wrong or missing credit?</h2>
        <p class="fix__text">Every fix needs a source, just like the find did. Corrections and new finds go through public GitHub forms; we answer credit requests within {site.responseHours} hours.</p>
        <div class="fix__actions">
          <Button href={correctionLink(find)} variant="secondary" size="l" iconEnd="arrow-up-right">Suggest a correction</Button>
          <Button href={submitFindLink()} variant="quiet" size="l" iconEnd="arrow-up-right">Submit a find</Button>
          <a class="link fix__more" href="/editorial-policy">How we verify</a>
        </div>
      </aside>
    </div>
  </article>
</Base>

<script>
  // A link can ask for a tab with ?tab=<id>: the timeline's "Watch the clip", the home hero's "Play clip", the island's
  // clip bar on the home page and on this page all send ?tab=clips#tabs (the page opens on Details since P8).
  // Unknown ids are ignored and the page keeps its first tab.
  const wanted = new URLSearchParams(location.search).get('tab');
  if (wanted) document.getElementById(`find-tab-${wanted}`)?.click();
  // The address follows the tab (#82 review N3): whichever way a tab is chosen (a link below, a click or the arrow
  // keys on the tab row), ?tab=<id> is written with replaceState, so a reload or a copied address opens the same tab
  // and Back is not filled with tab changes. The first tab is the page's default, so it clears the parameter.
  const tabEls = [...document.querySelectorAll<HTMLElement>('[role="tab"][id^="find-tab-"]')];
  // Every link names its own tab whatever the address says now: the first tab is the page's path with no query
  // (a bare #tabs would keep a ?tab= the page has written), the others ?tab=<id>, which replaces any query.
  const tabHref = (id: string) => (tabEls[0]?.id === `find-tab-${id}` ? `${location.pathname}#tabs` : `?tab=${encodeURIComponent(id)}#tabs`);
  const keepTab = (hash?: string) => {
    const on = tabEls.find((t) => t.getAttribute('aria-selected') === 'true');
    if (!on) return;
    const url = new URL(location.href);
    if (on === tabEls[0]) url.searchParams.delete('tab');
    else url.searchParams.set('tab', on.id.slice('find-tab-'.length));
    if (hash !== undefined) url.hash = hash;
    if (url.href !== location.href) history.replaceState(history.state, '', url);
  };
  const watch = new MutationObserver(() => keepTab());
  tabEls.forEach((t) => watch.observe(t, { attributes: true, attributeFilter: ['aria-selected'] }));
  // Links and pills that open a tab: select the tab, then bring the tab row into view. Each link's address names its
  // tab, so a Cmd, Ctrl, Shift or middle click (left to the browser: a new tab or window) opens the find on that tab;
  // only a plain left click switches in place (#82 review N2).
  document.querySelectorAll<HTMLElement>('[data-open-tab]').forEach((el) => {
    if (el instanceof HTMLAnchorElement && el.dataset.openTab && document.getElementById(`find-tab-${el.dataset.openTab}`)) el.setAttribute('href', tabHref(el.dataset.openTab));
    el.addEventListener('click', (e) => {
      const tab = document.getElementById(`find-tab-${el.dataset.openTab}`);
      if (!tab) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      tab.click();
      keepTab('#tabs');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.getElementById('tabs')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      tab.focus({ preventScroll: true });
    });
  });
  // Share: the system sheet where there is one, otherwise copy the link. Copied, the share icon turns into a check
  // and the label rolls to "Copied" for 1.6s (components.css, .copy; motion study item 11); a second press keeps it
  // there without restarting. Readers hear "Link copied" once.
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  const timers = new WeakMap<HTMLElement, number>();
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((el) => {
    el.addEventListener('click', async () => {
      const data = { title: document.title, url: location.href.split('#')[0] };
      try {
        if (navigator.share) { await navigator.share(data); return; }
        await navigator.clipboard.writeText(data.url);
        if (!el.hasAttribute('data-copied') && status) { status.textContent = ''; requestAnimationFrame(() => { status.textContent = 'Link copied'; }); }
        el.setAttribute('data-copied', '');
        clearTimeout(timers.get(el));
        timers.set(el, window.setTimeout(() => el.removeAttribute('data-copied'), 1600));
      } catch { /* the visitor closed the share sheet */ }
    });
  });
</script>

<style>
  .find { position: relative; isolation: isolate; }

  /* ---------- Art ---------- */
  .find__art { position: absolute; inset: 0 0 auto; z-index: -1; overflow: hidden; background: var(--bg); }
  .find__art img { width: 100%; height: 100%; object-fit: cover; }
  .find__art--glow, .find__art:has(> img[data-failed]) { background: var(--glow-hero), var(--bg); }
  .find__scrim { position: absolute; inset: 0; }

  .find__title {
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    font-weight: 900;
    text-transform: uppercase;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .find__badges { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .find__meta { color: var(--text-2); font-size: var(--text-body-s); }
  .find__synopsis { color: var(--text-1); }
  .find__hero :global(.find__also) { margin-top: var(--space-6); }
  .find__hero :global(.spoiler) { margin-top: var(--space-4); max-width: var(--measure-short); align-self: stretch; }
  .find__h2 { font-size: var(--text-h2); font-weight: 700; line-height: 1.2; }

  /* ---------- Grid (Disney related row) ---------- */
  .grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 21px var(--space-5); }

  /* ---------- Clips ---------- */
  .clips { display: flex; flex-direction: column; gap: var(--space-12); }
  .clips :global(.clips__main) { max-width: 960px; }
  .shots { display: flex; flex-direction: column; gap: var(--space-4); }
  .shots__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3) 10px; }
  .shot { display: flex; flex-direction: column; gap: var(--space-2); color: var(--text-2); }
  .shot__media { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-xs); background: var(--surface-2); color: var(--accent-text); }
  .shot__media--glow { background: var(--glow-hero), var(--surface-1); }
  .shot__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shot__label { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-caption); }
  .shot { transition: transform var(--dur-press) var(--ease-out); }
  .shot:active { transform: scale(0.98); }

  /* ---------- Details ---------- */
  .details { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: var(--space-16); align-items: start; }
  .details__main, .details__side { display: flex; flex-direction: column; gap: var(--space-10); min-width: 0; }
  .tips { display: flex; flex-direction: column; gap: var(--space-3); max-width: var(--measure); }
  .tips__title { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-title); font-weight: 600; }
  .tips__title span { display: inline-flex; color: var(--text-3); }
  .tips__list { display: flex; flex-direction: column; gap: var(--space-1); color: var(--text-2); }
  .tips__list li { position: relative; padding-left: 1.1em; }
  .tips__list li::before { content: '-'; position: absolute; left: 0; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-8); margin: 0; }
